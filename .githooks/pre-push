#!/bin/sh
set -eu

while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main)
            case "$remote_sha" in
                *[!0]*) echo "Push a feature branch and open a pull request to main." >&2; exit 1 ;;
            esac
            ;;
    esac
done
